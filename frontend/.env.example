# --- Frontend (Vite + React, public vars only: VITE_ prefix) ---
# Backend base URL (no trailing slash)
VITE_API_URL=http://localhost:8000
# WebSocket live stream URL
VITE_WS_URL=ws://localhost:8000/ws/live
# Supabase email auth (optional). Leave empty for labeled DEV MODE login.
# NEVER put a service_role key here (anon key only).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
