# --- Backend (FastAPI + RAFNet, server-only: NEVER prefix with VITE_/NEXT_PUBLIC_) ---
# development | production. Production fails closed at startup unless auth is
# enabled, Supabase is configured, and CORS is an explicit origin list.
RAFNET_ENV=development
# Supabase (optional in development: leave empty for in-memory store + dev auth)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
# Require Supabase JWT for the whole SOC API. Unset => true in production,
# false in development. Set true for any multi-user deployment.
SOC_REQUIRE_AUTH=false
MODEL_CHECKPOINT_DIR=experiments/checkpoints
RAFNET_DEVICE=cpu
# false = real RAFNet inference (needs torch + checkpoints); true = deterministic dev mock
MOCK_INFERENCE=false
# Risk thresholds (see RISK_ENGINE.md)
RISK_HIGH_CONFIDENCE=0.85
RISK_MEDIUM_CONFIDENCE=0.60
RISK_CRITICAL_SCORE=85
RISK_HIGH_SCORE=65
RISK_MEDIUM_SCORE=35
HOST=0.0.0.0
PORT=8000
# Comma-separated allowed frontend origins. Required in production; never "*"
# (wildcard + credentials is unsafe and rejected at startup).
SOC_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
# Legacy alias, still read when SOC_CORS_ORIGINS is unset:
# CORS_ORIGINS=
# Analyze rate limit (requests per minute per client IP)
RATE_LIMIT_ANALYZE_PER_MIN=30
# Live-chunk rate limit (sustained mic capture needs a higher budget)
RATE_LIMIT_CHUNK_PER_MIN=120
# Max request body bytes (413 above this when Content-Length is declared)
MAX_REQUEST_BYTES=33554432
# Legacy /api/v1 admin endpoints (fit-*, optimize-thresholds) mutate the live
# model: disabled by default (403). Enable only for local retraining.
RAFNET_ENABLE_ADMIN=false
# Honor X-Forwarded-For for rate-limit keys only behind a trusted proxy/LB.
TRUST_PROXY=false
# Optional: point at real experiment reports for /api/experiments
EXPERIMENTS_DIR=experiments
